# Copy to .env.deploy (never commit it). Values are in hPanel -> Advanced -> SSH Access.
# DEPLOY_HOST can also be a Host alias from ~/.ssh/config; then leave DEPLOY_USER empty.
DEPLOY_HOST=000.000.000.000
DEPLOY_PORT=65002
DEPLOY_USER=u123456789
# Path from the SSH home directory to the site's web root.
DEPLOY_PATH=domains/mictestingtool.com/public_html
