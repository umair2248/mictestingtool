Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Canonical hostname and HTTPS in one permanent redirect.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^mictestingtool\.com$ [NC]
  RewriteRule ^ https://mictestingtool.com%{REQUEST_URI} [R=301,L,NE]

  RewriteRule ^blog/sample-post(?:/index\.html)?/?$ /blog/how-to-test-your-microphone [R=301,L]

  # Redirect direct index.html requests, never internal rewrites.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L,NE]
  RewriteRule ^test/?$ / [R=301,L]
  RewriteRule ^blogs-list/?$ /blog [R=301,L]

  # Canonical public URLs omit trailing slashes.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  RewriteRule ^$ index.html [END]

  # Serve generated route HTML directly, without an SPA catch-all.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [END]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [END]
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^admin\.html$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>
