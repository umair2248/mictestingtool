{
  "name": "mic-testing-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "lint": "oxlint --config oxlint.config.json",
    "preview": "vite preview",
    "test:seo": "node scripts/verify-build.mjs",
    "test:browser": "playwright test",
    "test:localized": "node scripts/check-localized-source.mjs",
    "test:localized:browser": "playwright test --config playwright.localized.config.js",
    "test:article": "node scripts/check-article-source.mjs",
    "test:article:browser": "playwright test --config playwright.localized.config.js article.spec.js",
    "test:speaker": "node scripts/check-speaker-source.mjs",
    "test:speaker:browser": "playwright test --config playwright.localized.config.js speaker.spec.js",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.9",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.3.5"
  }
}
